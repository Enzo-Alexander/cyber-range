# 后端环境变量示例（复制为 .env 后按需修改）
# 本地默认使用 SQLite；切到 PostgreSQL 时设置 DATABASE_URL
APP_NAME=CyberRange
API_PREFIX=/api
SECRET_KEY=cyberrange-dev-secret-key-please-change-in-production-0001
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# DATABASE_URL=postgresql+psycopg://cyberrange:cyberrange@localhost:5432/cyberrange
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
